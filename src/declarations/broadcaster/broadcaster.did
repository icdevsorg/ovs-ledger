type ShareResult = 
 variant {
   Err: ShareCycleError;
   Ok: nat;
 };
type ShareCycleError = 
 variant {
   CustomError: record {
                  code: nat;
                  message: text;
                };
   NotEnoughCycles: record {
                      nat;
                      nat;
                    };
 };
type Broadcaster = 
 service {
   broadcast: (cycleShareLedger: text, items: vec record {
                                                    text;
                                                    nat;
                                                  }, cycles: nat) ->
    (ShareResult);
 };
service : () -> Broadcaster
